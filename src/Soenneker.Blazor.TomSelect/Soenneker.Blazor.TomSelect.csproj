<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <WebMinifierFolders>wwwroot/js</WebMinifierFolders>
        <WebMinifierCssEnabled>false</WebMinifierCssEnabled>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A Blazor interop library for the select user control library, Tom Select</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Blazor.TomSelect</AssemblyName>
        <PackageId>Soenneker.Blazor.TomSelect</PackageId>
        <PackageTags>blazor tomselect select tom-select tom input interop csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2024-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.blazor.tomselect</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.blazor.tomselect</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>preview</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Asyncs.Initializers" Version="11.0.138" />
        <PackageReference Include="Soenneker.Blazor.Extensions.EventCallback" Version="11.0.475" />
        <PackageReference Include="Soenneker.Blazor.Utils.InteropEventListener" Version="11.0.4211" />
        <PackageReference Include="Soenneker.Blazor.Utils.ResourceLoader" Version="11.0.1824" />
        <PackageReference Include="Soenneker.Extensions.Enumerable" Version="11.0.698" />
        <PackageReference Include="Soenneker.Extensions.List" Version="11.0.1013" />
        <PackageReference Include="Soenneker.Lepton.Suite" Version="11.0.138" />
        <PackageReference Include="Soenneker.Utils.Case" Version="11.0.121" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.Blazor.TomSelect.TrimSmoke" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Blazor.Extensions.IJSObjectReferences" Version="11.0.5" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Gen.Web.Minifier" Version="11.0.57" PrivateAssets="all" />
    </ItemGroup>
</Project>
